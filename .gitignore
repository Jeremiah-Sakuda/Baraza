.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local secrets and per-machine config. Never committed; .env.example is the
# documented shape and is committed.
.env
.env.local
*-key.json
service-account*.json
application_default_credentials.json

# Emulator scratch
.firestore-emulator/
firebase-debug.log

# Generated corpus artifacts are committed (judges need them to run make demo);
# intermediate render scratch is not.
fixtures/corpus/.render/
fixtures/corpus/*.tmp

# Run outputs
out/
*.log
!fixtures/**/*.jsonl
.coverage
.coverage.*

# Belt and braces. tests/unit/test_compliance_lints.py plants its violations in
# a copy of the tree under tmp_path, so nothing should ever match this — but an
# older revision wrote them into src/baraza/, and a leftover probe committed by
# accident would make `make compliance` exit 1 on a clean clone.
_compliance_probe*.py

.DS_Store
