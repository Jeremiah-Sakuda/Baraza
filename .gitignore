# Generated corpus artifacts are committed (judges need them to run make demo);
# intermediate render scratch is not.
fixtures/corpus/.render/
fixtures/corpus/*.tmp

# Run outputs
out/
*.log
!fixtures/**/*.jsonl

.DS_Store
